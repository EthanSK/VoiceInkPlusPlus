{
  "manifest_version": 3,
  "name": "VoiceInk YouTube Bridge",
  "version": "0.1.0",
  "description": "Connects VoiceInk++ and Agentic Mouse to YouTube playback and Chrome tab history.",
  "key": "",
  "permissions": ["alarms", "nativeMessaging", "scripting", "storage", "tabs"],
  "host_permissions": ["*://youtube.com/*", "*://*.youtube.com/*"],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["*://youtube.com/*", "*://*.youtube.com/*"],
      "js": ["content-script.js"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_title": "VoiceInk YouTube Bridge",
    "default_popup": "status.html"
  }
}
